# ParkSense Environment Variables
# Copy this file to .env and fill in your Supabase project credentials.
# NEVER commit your real .env file to version control.

# Supabase Project URL (from Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=

# Supabase Anon/Publishable Key (from Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_ANON_KEY=
